# =============================================================================
# Copy this file to .env.local and fill in values that make sense for your
# local machine. Never commit your .env.local to git — it's gitignored.
# =============================================================================

# Base URL of the local Next.js server. Leave as-is unless port 3000 is taken.
NEXT_PUBLIC_SERVER_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# PostgreSQL database connection.
# Assumes you have Postgres installed locally, listening on 5432, with:
#   - A database named "studyplanner"
#   - User "postgres" with password "postgres"
# Adjust to match your Postgres install. If you use a different password
# or port, change it in both of the lines below.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/studyplanner?schema=public
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/studyplanner?schema=public

# -----------------------------------------------------------------------------
# App mode. "DEV" skips Microsoft OAuth sign-in and auto-logs in as Superadmin.
# Keep this as DEV when running the Electron desktop app.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MODE=DEV

# -----------------------------------------------------------------------------
# Microsoft Entra (Azure AD) OAuth config. Only used when NEXT_PUBLIC_MODE is
# NOT "DEV". Safe defaults shown; replace with real values if you have them.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLIENT_ID=desktop-dev-client
NEXT_PUBLIC_AUTHORITY=https://login.microsoftonline.com/common
NEXT_PUBLIC_REDIRECTURI=http://127.0.0.1:3000/view/dashboard
NEXT_PUBLIC_POSTLOGOUTREDIRECTURI=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Outgoing email (for password reset / invites etc). Not required for the
# desktop app to boot. Use a Gmail account with an App Password if you want
# real email sending.
# -----------------------------------------------------------------------------
GMAIL_EMAIL=dev@example.com
GMAIL_APP_PW=dev-password

# -----------------------------------------------------------------------------
# Default user setup.
# -----------------------------------------------------------------------------
DEFAULT_USER_GROUP_ID=1
DEFAULT_USER_ROLE=Superadmin
WHITELIST_MODE=false

# -----------------------------------------------------------------------------
# Secret used to sign local desktop session tokens. Generate a fresh random
# string in production — the default below is only for local dev.
# -----------------------------------------------------------------------------
SESSION_SECRET=desktop-dev-session-secret-please-change

# -----------------------------------------------------------------------------
# Supabase (optional, only if you use remote storage for study planner files).
# Leave blank for a fully local dev setup.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DB_URL=
NEXT_PUBLIC_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_NAME=students-study-planners
