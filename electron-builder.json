{
  "appId": "com.studyplanner.app",
  "productName": "Student Study Planner",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "next.config.mjs",
    "package.json",
    ".next/**/*",
    "public/**/*",
    "node_modules/**/*"
  ],
  "mac": {
    "category": "public.app-category.education",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Education"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Student Study Planner"
  }
}